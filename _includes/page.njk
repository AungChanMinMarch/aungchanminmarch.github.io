---
layout: base.njk
---
<style type="text/css">
  .progress-container{
    width: 90vw;
    height: 30px;
    border-radius: 25px;
  }
  .progress-bar {
    height: 30px;
    width: 0;
    background-color: var(--my-theme-color);
    border-radius: 25px;
    animation: progress 50s linear forwards;
  }
  @keyframes progress {
      0% { width: 0; }
      100% { width: 90%; }
  }
  @keyframes loaded {
    to { width: 100% }
  }
</style>
<div id="loader" class="min-w-full min-h-full fixed top-0 left-0 bg-primary z-50 flex justify-center items-center">
  <div class="progress-container bg-secondary">
    <div class="progress-bar"></div>
  </div>
</div>
<link id="style" rel="stylesheet" type="text/css" href="/assets/style.css">
<div style="display: none;">
  {% raw %}\(
    \def\curl#1{\text{curl }#1}

    \def\bracket#1{\left({#1}\right)}
    \def\sbracket#1{\left[{#1}\right]} %square bracket
    \def\cbracket#1{\left\{{#1}\right\}} %curly bracket

    \def\Lim_#1{{\lim\limits_{#1}}}
    \def\limit{{\lim\limits_{n \to \infty}}}

    \def\dsum{{\displaystyle \sum}}
    \def\Sum_#1^#2{{\sum\limits_{#1}^{#2}}}
    \def\summ{\sum\limits_{n=0}^{\infty}}

    \newcommand{\inverse}[2]{{#1}^{-1}\left[{#2}\right]}
    
    \def\topologyTau{{\Large{\tau}}}
    \def\Tau{{\tau}}
    \def\TauStar{{\tau^{*}}}
    \def\base{{\mathscr{B}}}
    \def\subbase{{\mathcal{S}}}
    \def\discrete{{\mathscr{D}}}
    \def\indiscrete{{\mathscr{I}}}
    \def\usual{{\mathscr{u}}}
    \def\interior#1{{#1}^{\circ}}
    \def\b#1{b({#1})}
    \def\closure#1{\overline{#1}}
    \def\seq#1{\langle {#1} \rangle}

    \def\composite{{\circ}}
    
    \def\R{{\mathbb R}}
    \def\C{{\mathbb C}}
    \def\N{{\mathbb N}}
		\def\Z{{\mathbb Z}}
    \def\fQ{{\mathcal{Q}}}
    \def\riemannR{{\mathscr{R}}}
    \def\K{{\mathbb K}} % usually field K
    \def\ep{\varepsilon}
    \def\d{\displaystyle}
    \def\grad{\vec{\nabla}}
    \def\q{q}

    \def\bf{ { \mathbf{f} } }
    \def\by{ { \mathbf{y} } }
    \def\beta{ { \boldsymbol{\eta} } }
    \def\bPhi{ { \boldsymbol{\Phi} } }

		\def\conj#1{\, \overline{#1} \,}

    \def\mod#1{\left | {#1} \right |}
    \def\abs#1{\left | {#1} \right |}

    \def\crossProduct#1{\left\|\begin{array}{ccc} #1 \end{array}\right\|}

    \newcommand{\partialwrt}[2][]{\frac{\partial {#1}}{\partial {#2}}}
    \newcommand{\dpartialwrt}[2][]{\dfrac{\partial {#1}}{\partial {#2}}}

    \def\upint{\mkern3mu\overline{\vphantom{\intop}\mkern7mu}\mkern-20mu\int}
    \def\lowint{\mkern3mu\underline{\vphantom{\intop}\mkern7mu}\mkern-10mu\int}
    \def\lowsup_#1{_{{\lower{0.3em}{#1}}}}

		\def\indeterminate#1{\left( \text{indeterminate form: } \frac{#1}{#1} \right) }
		\def\indeterminatezero{\left( \text{indeterminate form: } \frac{0}{0} \right) }
		\def\indeterminateinf{\left( \text{indeterminate form: } \frac{\infty}{\infty} \right) }

    \def\uvec#1{\mathbf{\hat#1}}
    \def\bvec#1{\mathbf{\vec{#1}}}
    \newcommand{\cvec}[1]{\left(\begin{array}{c}
      #1
    \end{array}\right)}
    
    \def\scalarProduct{\cdot}
    \newcommand{\curlExpand}[3]{\begin{vmatrix}
      \uvec{i} & \uvec{j} & \uvec{k} \\
      \dpartialwrt{x} & \dpartialwrt{y} & \dpartialwrt{z} \\
      #1 & #2 & #3
    \end{vmatrix}}
    
    \def\norm#1{\| #1 \|}
\){% endraw %}
</div>
<main>
    {{ content | safe }}
</main>
<script type="text/javascript" src="/assets/index.js"></script>

{% if includes %}
  {% for jsFileName in includes %}
    <script type="text/javascript" src="/assets/{{ jsFileName }}.js"></script>
  {% endfor %}
{% endif %}

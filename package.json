{
  "name": "myweb",
  "version": "1.0.0",
  "description": "Welcome to [acmlearnlounge](/404)! My aim is to share my knowledge and make math awesome and understandable. I believe that anyone can grasp the magic of math. My goal is to break down complex concepts into bite-sized lessons that even your grandma could understand.",
  "main": "reveal.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "webpack": "npm run webpack --no-watch --mode development",
    "start": "npm run 11ty & npm run webpack:watch",
    "11ty": "npx @11ty/eleventy --serve --watch",
    "webpack:watch": "webpack --config webpack.config.js --mode development --watch",
    "build": "npm run eleventy:build & npm run webpack:build",
    "eleventy:build": "npx @11ty/eleventy",
    "webpack:build": "webpack --config webpack.config.js --mode production"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.3.5",
    "autoprefixer": "^10.4.19",
    "css-loader": "^7.1.1",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.1.1",
    "tailwindcss": "^3.4.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@pixi/graphics-extras": "^7.3.1",
    "@svgdotjs/svg.js": "^3.2.0",
    "babel-loader": "^9.1.3",
    "cytoscape": "^3.29.2",
    "firebase": "^11.0.2",
    "function-plot": "^1.24.0",
    "octokit": "^3.1.1",
    "pixi.js": "^7.3.1",
    "style-loader": "^4.0.0",
    "styled-components": "^6.1.11"
  }
}
